# SOLO DESARROLLO LOCAL. Copia a .env (no se versiona) y ajusta los valores.
# Usado por docker-compose.yml de la raíz: frontend + backend contra el PostgreSQL del anfitrión.

# PostgreSQL instalado en la máquina (la BD debe existir; Flyway crea las tablas al arrancar).
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/inventary
DB_USERNAME=postgres
DB_PASSWORD=change-this-password

SPRING_PROFILES_ACTIVE=dev
API_PORT=8080
WEB_PORT=3000

# Genera un secreto propio de al menos 32 bytes.
JWT_SECRET=local-dev-secret-change-this-value-to-a-random-secret-32bytes
JWT_TTL_MINUTES=60

# El frontend en Docker usa el mismo origen (proxy nginx). Incluye aquí el origen de `npm run dev` si lo usas.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Usuario inicial; solo se crea si la tabla de usuarios está vacía.
# La contraseña necesita 16+ caracteres y no puede contener el nombre de usuario.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=LocalOnly-StartSecurePassword-123!

SWAGGER_ENABLED=true
