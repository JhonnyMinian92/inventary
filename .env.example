# SOLO DESARROLLO LOCAL. Copia a .env (no se versiona) y ajusta los valores.
# Usado por docker-compose.yml de la raíz: frontend + backend contra el PostgreSQL del anfitrión.

# PostgreSQL instalado en la máquina (la BD debe existir; Flyway crea las tablas al arrancar).
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/inventary
DB_USERNAME=postgres
DB_PASSWORD=change-this-password

SPRING_PROFILES_ACTIVE=dev
API_PORT=8080
WEB_PORT=3000

# Genera un secreto propio de al menos 32 bytes.
JWT_SECRET=local-dev-secret-change-this-value-to-a-random-secret-32bytes
JWT_TTL_MINUTES=60

# El frontend en Docker usa el mismo origen (proxy nginx). Incluye aquí el origen de `npm run dev` si lo usas.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Usuario inicial; solo se crea si la tabla de usuarios está vacía.
# La contraseña necesita 8 a 15 caracteres (mayúscula, minúscula, número y símbolo) y no puede contener el nombre de usuario.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Cambiar-Esta1!

SWAGGER_ENABLED=true

# Login: credenciales cifradas obligatorias (ECDH P-256 + AES-256-GCM) y bloqueo temporal por cuenta.
LOGIN_ENCRYPTION_REQUIRED=true
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Integración WhatsApp/n8n. Clave de máquina (32+ bytes) que n8n envía en el header X-Integration-Key.
# Vacía = /api/v1/integrations/whatsapp/** responde 401. Generar con: openssl rand -hex 32
WHATSAPP_INTEGRATION_API_KEY=

# n8n (http://localhost:5678). La clave cifra las credenciales guardadas en n8n: no cambiarla después del primer arranque.
# Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
# URL pública HTTPS para los webhooks de WhatsApp (p. ej. un túnel cloudflared/ngrok). Con túnel, poner N8N_PROXY_HOPS=1.
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
