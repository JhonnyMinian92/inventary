# SOLO DESARROLLO LOCAL. No reutilizar estos valores en staging/producción.
# Copia a .env y reemplaza todos los valores marcados para tu entorno.
SPRING_PROFILES_ACTIVE=dev
DB_USERNAME=postgres
DB_PASSWORD=local-only-change-this-password
POSTGRES_PORT=5432
API_PORT=8080
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Genera un secreto propio de al menos 32 bytes; el ejemplo solo sirve para desarrollo local.
JWT_SECRET=local-dev-secret-change-this-value-to-a-random-secret-32bytes
JWT_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:4200
BOOTSTRAP_ADMIN_USERNAME=admin
# Debe respetar la política de contraseña del bootstrap (máximo 15 caracteres).
BOOTSTRAP_ADMIN_PASSWORD=LocalOnly-123!
SWAGGER_ENABLED=true
GRAPHIQL_ENABLED=false

# Opcional; dejar vacío si la integración no está configurada.
WHATSAPP_INTEGRATION_API_KEY=

# Kafka es opcional. Para usar el broker local: docker compose --profile kafka up --build
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=inventary.domain-events
KAFKA_DLQ_TOPIC=inventary.domain-events.DLQ
KAFKA_CONSUMER_GROUP=inventary-public-cache
KAFKA_CONSUMER_MAX_MESSAGE_BYTES=1048576
KAFKA_MAX_POLL_RECORDS=100

# Imágenes de producto: PNG/JPEG decodificables, tamaño limitado y almacenamiento persistente.
MEDIA_STORAGE_PATH=/data/product-images
MEDIA_MAX_FILE_SIZE=5MB
MEDIA_MAX_REQUEST_SIZE=6MB
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_MAX_REQUEST_BYTES=6291456

# Zona horaria de negocio para cortes diarios de reportes (IANA).
REPORTS_TIME_ZONE=America/Guayaquil
# Segregación de funciones: quien crea/envía una orden de compra no puede aprobarla.
PURCHASING_REQUIRE_DISTINCT_APPROVER=true
# Tamaño máximo del cuerpo JSON aceptado (bytes).
MAX_REQUEST_BODY_BYTES=1048576
# "none" ignora X-Forwarded-For. Usar "native" solo detrás de un proxy confiable que sobrescriba la cabecera.
FORWARD_HEADERS_STRATEGY=none
