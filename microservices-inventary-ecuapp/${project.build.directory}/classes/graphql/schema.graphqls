type Query {
  publicProducts(page: Int = 0, size: Int = 20): ProductPage!
  publicProduct(identifier: String!): PublicProduct
  activeCategories(page: Int = 0, size: Int = 20): CategoryPage!
}

type ProductPage {
  items: [PublicProduct!]!
  page: Int!
  size: Int!
  totalElements: String!
  totalPages: Int!
}

type PublicProduct {
  id: ID!
  sku: String!
  name: String!
  description: String
  categoryName: String!
  price: String!
  currency: String!
  imageUrl: String
  available: Boolean!
}

type CategoryPage {
  items: [PublicCategory!]!
  page: Int!
  size: Int!
  totalElements: String!
  totalPages: Int!
}

type PublicCategory {
  id: ID!
  name: String!
  slug: String!
  description: String
}
